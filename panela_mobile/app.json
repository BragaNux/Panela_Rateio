{
  "expo": {
    "name": "Panela",
    "slug": "panela",
    "scheme": "panela",
    "version": "1.0.1",
    "sdkVersion": "54.0.0",

    "orientation": "portrait",

    "splash": {
      "image": "./assets/splash/splashscreen_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },

    "android": {
      "package": "com.anonymous.panela",
      "jsEngine": "jsc",
      "splash": {
        "image": "./assets/splash/splashscreen_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },

    "ios": {
      "splash": {
        "image": "./assets/splash/splashscreen_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    }
  }
}
